{
  "name": "flatform",
  "private": true,
  "version": "1.1.0",
  "description": "A slicer for 2D fabrication: it slices any 3D model into flat parts for laser cutters, CNC routers and flat 3D printing, with the joints, numbers and cut files to build it back in 3D.",
  "author": {
    "name": "Roy Borkin",
    "email": "royborkin@gmail.com",
    "url": "https://royborkin.github.io/"
  },
  "homepage": "https://royborkin.github.io/FlatForm/",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/notices.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "notices": "node scripts/notices.mjs",
    "version:set": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "clipper-lib": "^6.4.2",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "hersheytext": "^2.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.70.0",
    "manifold-3d": "^3.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rhino3dm": "^8.35.0",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18",
    "zundo": "^2.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "laser-cutting",
    "cnc",
    "fabrication",
    "dxf",
    "unfold",
    "parametric",
    "three.js",
    "tauri"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/royborkin/FlatForm.git"
  }
}
