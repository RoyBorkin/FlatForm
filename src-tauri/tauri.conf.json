{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FlatForm",
  "version": "0.2.0",
  "identifier": "app.flatform.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlatForm",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "category": "DeveloperTool",
    "shortDescription": "Turn 3D shapes into flat sheet parts",
    "longDescription": "FlatForm turns any 3D shape into flat parts you can laser-cut or CNC-cut from sheet material, with numbered holes, joinery, nesting and DXF/SVG/PDF export.",
    "copyright": "© 2026 Roy Borkin · royborkin@gmail.com · https://royborkin.github.io/ · MIT",
    "publisher": "Roy Borkin",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
